<?xml version="1.0" encoding="utf-8"?>
<!--
  Copie este arquivo para Environment.props e ajuste os caminhos da sua máquina.
  Environment.props é ignorado pelo git justamente porque é específico de cada máquina.

  VALHEIM_INSTALL  → pasta da instalação do jogo (a que contém valheim.x86_64)
  BEPINEX_PATH     → pasta BepInEx. Atenção: com r2modman/Thunderstore o BepInEx NÃO
                     fica dentro da pasta do jogo, e sim dentro do perfil do gerenciador.
                     Sem essa linha, o Jotunn assume $(VALHEIM_INSTALL)/BepInEx e a
                     compilação falha por não achar BepInEx.dll.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <VALHEIM_INSTALL>/caminho/para/SteamLibrary/steamapps/common/Valheim</VALHEIM_INSTALL>
    <BEPINEX_PATH>$(HOME)/.config/r2modmanPlus-local/Valheim/profiles/Default/BepInEx</BEPINEX_PATH>
  </PropertyGroup>
</Project>
